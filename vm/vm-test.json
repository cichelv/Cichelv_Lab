{
  "name": "vm-test",
  "zone": "us-central1-c",
  "machine_type": "e2-small",
  "image": "debian-12-bookworm-v20250910",
  "network": "default",
  "tags": ["debian", "lab", "http-server", "https-server"],
  "boot_disk": {
    "size": 10,
    "type": "pd-balanced"
  },
  "labels": {
    "env": "lab",
    "os": "debian"
  },
  "network_interface": {
    "network": "${var.network}",
    "access_config": {}
  },
  "service_account": {
    "email": "${var.mail}",
    "scopes": ["https://www.googleapis.com/auth/cloud-platform"]
  }
}
